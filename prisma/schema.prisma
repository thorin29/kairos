// Family Dashboard — core schema
// Modules (bible, school, exercise) attach detail tables to Task as we build them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------
// People
// ---------------------------------------------------------------

enum Role {
  ADMIN // parent: can assign to anyone, edit templates and plans
  MEMBER
}

model User {
  id          String  @id @default(cuid())
  name        String  @unique // short name used on the dashboard
  displayName String?
  role        Role    @default(MEMBER)
  pinHash     String? // only set for ADMIN accounts while we're local-only

  // Optional email: the address invites are sent to, and a second sign-in
  // identifier (login accepts name or email). Null for anyone without one.
  email       String? @unique

  // First-party login credential. Null means this person is a wall-tablet-only
  // profile with no personal sign-in (e.g. a young child) — the default. A
  // password is set only by redeeming an admin-issued invite; there is no
  // self-signup. Login identity is `name` (unique), so no email is needed.
  passwordHash      String?
  // Embedded in the personal session cookie. Bumping it invalidates every
  // existing session for this person (password reset, admin disabling login).
  credentialVersion Int     @default(0)

  avatarPath  String? // uploaded image, stored under appdata

  // Date only — a birthday is a calendar day, never an instant, and it has
  // no year-relative meaning that a timestamp would capture.
  birthday DateTime? @db.Date
  // Whether this person's birthday tints its whole day column on the calendar.
  shadeBirthday Boolean @default(true)
  color       String  @default("#64748b") // this person's color in the all-users calendar
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  gameProfile     GameProfile?
  gameSessions    GameSession[]
  tasks           Task[]         @relation("TaskOwner")
  schoolClasses   SchoolClass[]
  createdTasks    Task[]         @relation("TaskCreator")
  events          Event[]
  choreAssignments ChoreAssignment[]
  calendars       ExternalCalendar[]
  groceryItems    ShoppingItem[]    @relation("GroceryAssignee")
  workoutExercises Exercise[]        @relation("WorkoutExercises")
  workoutSchedules WorkoutSchedule[] @relation("WorkoutSchedules")
  workoutSessions  WorkoutSession[]  @relation("WorkoutSessions")
  plannedWorkouts  PlannedWorkout[]  @relation("PlannedWorkouts")
  hiitWorkouts     HiitWorkout[]
  invites          Invite[]
  sportSkips       SportSkip[]
  eventParticipations EventParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------
// Tasks — the single completable unit behind every category.
// Percent complete, overdue rollover, streaks, and the weekly
// scoreboard are all queries against this one table.
// ---------------------------------------------------------------

model Term {
  id        String        @id @default(cuid())
  name      String
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  classes   SchoolClass[]
}

model SchoolClass {
  id      String  @id @default(cuid())
  name    String
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  termId  String?
  term    Term?   @relation(fields: [termId], references: [id], onDelete: SetNull)
  color   String?
  // Optional recurring CLASS event that is this class's meeting time.
  eventId String? @unique
  event   Event?  @relation("ClassMeeting", fields: [eventId], references: [id], onDelete: SetNull)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([termId])
}

enum SchoolWorkType {
  HOMEWORK
  ASSIGNMENT
  TEST
  PROJECT
}

model SchoolWork {
  id        String         @id @default(cuid())
  taskId    String         @unique
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      SchoolWorkType @default(ASSIGNMENT)
  subject   String?
  createdAt DateTime       @default(now())
}

enum Category {
  CHORE
  EXERCISE
  BIBLE
  SCHOOL
  WORK
  APPOINTMENT
  OTHER
}

enum TaskStatus {
  PENDING
  COMPLETE
  SKIPPED // excused; counts against neither numerator nor denominator
}

model Task {
  id       String     @id @default(cuid())
  userId   String
  user     User       @relation("TaskOwner", fields: [userId], references: [id], onDelete: Cascade)
  category Category
  title    String
  notes    String?

  // Date only, no timezone. A chore is due "Tuesday", not "Tuesday 00:00 UTC".
  dueDate     DateTime   @db.Date
  // For "do anytime" chores: the task shows from its dueDate but isn't late
  // until after this date (the end of its period). Null for ordinary tasks,
  // which are late the day after dueDate.
  lateAfter   DateTime?  @db.Date
  status      TaskStatus @default(PENDING)
  completedAt DateTime?

  // Never rewrite dueDate to roll a task forward — overdue is a display
  // rule (dueDate <= today AND status = PENDING), so history stays intact.

  createdById String?
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id])

  // The assignment this row was generated from. Reconciliation matches on
  // this rather than on the person, so a chore handed to someone else keeps
  // filling its slot instead of being rebuilt for the original owner.
  generatedFrom String?

  // Released back to the household: still due, but nobody owns it yet. Open
  // items drop out of the original person's score and appear on the
  // dashboard for anyone to claim.
  isOpen Boolean @default(false)

  sortOrder Int @default(0)

  // Set on generated chore tasks. Gives every instance of the same job a
  // shared identity so a superseded one can be recognized.
  choreId String?
  chore   Chore?  @relation(fields: [choreId], references: [id], onDelete: SetNull)

  // Optional link to a timed calendar block (a class, a shift, an appointment)
  eventId String? @unique
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // School module detail (assignment/test type + subject), when category=SCHOOL.
  schoolWork SchoolWork?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Makes chore generation idempotent: re-running it can never duplicate a
  // row. Postgres treats NULLs as distinct, so hand-added tasks are exempt.
  @@unique([choreId, userId, dueDate])
  @@index([userId, dueDate])
  @@index([dueDate, status])
  @@index([userId, category, dueDate])
  @@index([choreId, dueDate])
  @@index([isOpen, dueDate])
}

// ---------------------------------------------------------------
// Events — anything that occupies time on the week grid.
// ---------------------------------------------------------------

enum EventKind {
  CLASS
  WORK
  APPOINTMENT
  BIRTHDAY
  EXTERNAL // pulled from a subscribed ICS feed
  OTHER
}

// Admin-managed custom event types (e.g. "Hockey game") with their own colour.
// An event can point at one; when it does, that colour wins on the calendar.
model EventType {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  sportWorkout Boolean @default(false)
  defaultMinutes Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  events Event[]
}

model Event {
  id     String  @id @default(cuid())
  // Null when the event belongs to the shared "Family" identity rather than a
  // specific person (isFamily is true in that case).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  isFamily Boolean @default(false)

  kind     EventKind
  eventTypeId String?
  eventType   EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  title    String
  location String?
  notes    String?

  // Timestamptz — a 4pm shift is a real instant, unlike a task's due date.
  startsAt DateTime
  endsAt   DateTime
  allDay   Boolean  @default(false)
  // Whether an all-day event tints its whole day column on the calendar.
  shadeDay Boolean  @default(true)

  // RFC 5545 RRULE for repeating classes and shifts.
  rrule       String?
  recurrenceId String? // parent series id, for single-occurrence edits
  // The original occurrence date this override replaces, so the parent series
  // skips that date. The child's own startsAt may differ (a moved occurrence).
  recurrenceDate DateTime? @db.Date

  externalCalendarId String?
  externalCalendar   ExternalCalendar? @relation(fields: [externalCalendarId], references: [id], onDelete: Cascade)
  externalUid        String? // ICS UID, for dedupe across refetches

  task Task?
  sportSkips SportSkip[]
  participants EventParticipant[]
  schoolClass SchoolClass? @relation("ClassMeeting")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalCalendarId, externalUid])
  @@index([userId, startsAt])
  @@index([startsAt, endsAt])
  @@index([eventTypeId])
}

model ExternalCalendar {
  id            String    @id @default(cuid())
  // Null when the feed belongs to the shared "Family" identity rather than a
  // specific person (isFamily is true in that case), mirroring Event.
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isFamily      Boolean   @default(false)
  name          String
  url           String // webcal/ICS
  color         String?
  isActive      Boolean   @default(true)
  lastFetchedAt DateTime?
  lastError     String?

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------
// Chores
//
// A Chore is the job itself ("Vacuum the living room"), independent of who
// does it or when. That identity is what drives expiry: an unfinished
// instance expires the moment the same chore comes due again for anyone,
// because the floor only needs doing once. Expiry is never time-based.
// ---------------------------------------------------------------

model Chore {
  id        String  @id @default(cuid())
  title     String  @unique
  notes     String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  // A shared chore belongs to nobody. It appears up for grabs, and once
  // somebody finishes it, the next one is scheduled intervalDays later —
  // measured from completion, not from a fixed weekday. Mowing is the
  // motivating case: it depends on how fast the grass grew, not on it
  // being Saturday.
  isPool       Boolean @default(false)
  intervalDays Int?

  // A collaborative chore is assigned to several people who each do their
  // part; the flag just labels it as shared work. intervalWeeks lets an
  // assigned chore recur less often than weekly — 2 is every other week.
  isCollaborative Boolean @default(false)
  intervalWeeks   Int     @default(1)

  // A "do anytime" chore: assigned to a person, sits on their list for the
  // whole period (intervalWeeks long), done any day, only late at period end.
  isAnytime Boolean @default(false)

  // Effort weight, admin-only, on a 1-5 scale. Used to see whether the week's
  // chores are balanced across the family; never shown to users. Can be locked
  // so it isn't changed by accident.
  effort       Int     @default(3)
  effortLocked Boolean @default(false)

  // Seasonal chores stop rather than pile up. Resuming puts one out
  // immediately rather than waiting a full interval.
  isPaused Boolean @default(false)

  assignments ChoreAssignment[]
  tasks       Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChoreAssignment {
  id      String @id @default(cuid())
  choreId String
  chore   Chore  @relation(fields: [choreId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = Sunday .. 6 = Saturday

  // Edits apply going forward; already-generated tasks are left alone.
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([choreId, userId, dayOfWeek])
  @@index([dayOfWeek, isActive])
}

// ---------------------------------------------------------------
// Bible reading
//
// A plan is a dated list of passages — the schedule, not the text. Plans are
// data, never code: a household's own plan lives here and never enters the
// repository. Only one plan is published at a time; drafts can be reviewed
// and rebuilt freely because nothing reaches anyone's list until published.
// ---------------------------------------------------------------

model ReadingPlan {
  id     String  @id @default(cuid())
  name   String
  notes  String?

  isPublished Boolean @default(false)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  days ReadingDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReadingDay {
  id     String      @id @default(cuid())
  planId String
  plan   ReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  day     DateTime @db.Date
  passage String

  // A special reading — Christmas, Easter — that occupies a date but is left
  // out of the coverage statistics, so it can't push a percentage past what
  // the plan proper has actually taken the household through.
  isExtra Boolean @default(false)

  @@unique([planId, day])
  @@index([planId, day])
}

// What a household has already read, marked by an admin, at chapter
// granularity so a book they're part way through can be ticked off as far as
// they've read. This is the manual baseline; the published plan's coverage is
// counted separately from its scheduled days.
model ChapterCompletion {
  bookName    String
  chapter     Int
  completedAt DateTime @default(now())

  @@id([bookName, chapter])
}

// ---------------------------------------------------------------
// Screen time
//
// A daily allowance plus a small number of weekly tokens that buy extra
// minutes. Tokens are the interesting part: they're scarce, so spending one
// is a decision, which is what makes them usable as a reward later.
// ---------------------------------------------------------------

model GameProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyMinutes Int     @default(60)
  weeklyTokens Int     @default(3)
  tokenMinutes Int     @default(20)
  isActive     Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model GameSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Date only: a session belongs to a day's allowance, not to an instant.
  day     DateTime @db.Date
  minutes Int

  // Whether this session spent one of the week's tokens.
  usedToken Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, day])
  @@index([day])
}

// ---------------------------------------------------------------
// Settings
//
// Small key/value store. Currently holds the scoring start date, which lets
// the scoreboard ignore everything from before a chosen day without deleting
// any history — useful for starting a season even after months of testing.
// ---------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A person attending an event beyond its owner. For sport-workout events this
// is the set who each get a completion prompt; empty means "just the owner".
model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// A sport-workout calendar event's per-person, per-day "no". Its absence
// (with no logged session for that occurrence) is what shows the prompt; keyed
// on the occurrence date so every day and every person is independent.
model SportSkip {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([eventId, userId, date])
  @@index([userId, date])
}

// A one-time invitation to set up a personal login for an existing person.
// The raw token is shown to the admin once and never stored; only its hash
// lives here. Redeeming it sets the person's password and deletes the invite.
// This is the only path to a loginable account — there is no self-signup.
model Invite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------
// Weather — one row, refreshed on a 15-minute timer, shared by all.
// ---------------------------------------------------------------

model WeatherCache {
  id          Int      @id @default(1)
  payload     Json
  fetchedAt   DateTime @default(now())
  provider    String
  lastError   String?
}

// ---------------------------------------------------------------
// Groceries — a shared shopping list that learns which items the
// household buys, filtered by the store you're shopping at.
// ---------------------------------------------------------------

model Store {
  id        String  @id @default(cuid())
  name      String  @unique
  icon      String  @default("🛒")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  catalog GroceryItem[]
  items   ShoppingItem[]
}

// The remembered catalog. Adding a needed item finds or creates its entry,
// bumps the use count, and reuses the icon, so common things surface first
// and don't need typing or re-picking an icon each time.
model GroceryItem {
  id             String   @id @default(cuid())
  name           String   @unique
  icon           String   @default("📦")
  defaultStoreId String?
  defaultStore   Store?   @relation(fields: [defaultStoreId], references: [id], onDelete: SetNull)
  useCount       Int      @default(0)
  isActive       Boolean  @default(true)
  lastUsedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
}

// One line currently on the list. Name and icon are snapshotted so editing the
// catalog later doesn't rewrite history on the list.
model ShoppingItem {
  id           String    @id @default(cuid())
  name         String
  icon         String    @default("📦")
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation("GroceryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  note         String?
  boughtAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([storeId])
}

// ---------------------------------------------------------------
// Exercise — routines of movements, assigned to people by weekday,
// generated into daily tasks, with a log of what was actually done.
// ---------------------------------------------------------------

enum WorkoutCategory {
  WEIGHTS
  RUNNING
  ROWING
  SPORT
  STRETCHING
  HIIT
  ISOMETRIC
  RUCKING
}

enum WorkoutImplement {
  BARBELL
  DUMBBELL
  KETTLEBELL
  BODYWEIGHT
  NONE
}

// The headline number an exercise is graphed on — everything else logged is
// detail. Bench is graphed on WEIGHT; a run on DISTANCE; a row on METERS.
enum WorkoutType {
  AMRAP
  FOR_TIME
  MAX_SETS
  FOR_REPS
  STATIONS
  TIMED_STATIONS
  PYRAMID
  TABATA
}

enum WorkoutMetric {
  WEIGHT
  DISTANCE
  METERS
  DURATION
  REPS
}

// A built-in sub-category for weights, so the pool of lifts can be organised
// the way people think about a session ("chest day"). Weights only.
enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  LEGS
  ARMS
  CORE
  FULL_BODY
}

// The household exercise pool: a shared, admin-managed library of movements,
// categorised, with a muscle-group sub-category for weights. People pick from
// this pool when planning and logging, so the same "Bench Press" is one shared
// thing everyone can be compared on — unlike the per-person Exercise below.
model PoolExercise {
  id          String          @id @default(cuid())
  category    WorkoutCategory
  name        String
  muscleGroup MuscleGroup?
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  sets    SessionSet[]
  planned PlannedExercise[]
  hiitMovements HiitWorkoutMovement[]

  @@unique([category, name])
  @@index([category, muscleGroup, isActive])
}

// A named HIIT/CrossFit workout (e.g. "Cindy") of a given type, built from
// HIIT-pool movements. ownerId null means the shared household pool; a set
// ownerId means it's that person's own, pending share/approval.
model HiitWorkout {
  id           String       @id @default(cuid())
  name         String
  type         WorkoutType
  ownerId      String?
  owner        User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  approved     Boolean      @default(true)
  shareRequested Boolean    @default(false)
  capSec       Int? // AMRAP time cap / timed-station duration
  pyramidStart Int?
  pyramidEnd   Int?
  pyramidStep  Int?         @default(1)
  notes        String?
  heroWod      Boolean      @default(false)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  movements HiitWorkoutMovement[]
  planned   PlannedWorkout[]

  @@index([ownerId])
  @@index([approved])
}

model HiitWorkoutMovement {
  id             String       @id @default(cuid())
  hiitWorkoutId  String
  hiitWorkout    HiitWorkout  @relation(fields: [hiitWorkoutId], references: [id], onDelete: Cascade)
  poolExerciseId String
  poolExercise   PoolExercise @relation(fields: [poolExerciseId], references: [id], onDelete: Cascade)
  reps           Int?
  distance       Float?
  weight         Float?
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([hiitWorkoutId])
  @@index([poolExerciseId])
}

// A person's own definition of a thing they do. Built once, reused: it drives
// what the log form asks for and whether the exercise gets a line on a graph.
model Exercise {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation("WorkoutExercises", fields: [userId], references: [id], onDelete: Cascade)
  category  WorkoutCategory
  name      String
  implement WorkoutImplement?
  unit      String        // "lb", "kg", "mi", "km", "m", "min", "sec", "rep"
  metric    WorkoutMetric  @default(WEIGHT)
  tracked   Boolean @default(true) // graph this one?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  schedules WorkoutSchedule[]
  sets      SessionSet[]

  @@index([userId, category, isActive])
}

// "On Mondays, expect Bench." A weekday recurrence that shapes the daily
// prompt. It can be paused (with a nudge to resume) or given an end date
// (with a nudge to make a new plan before it lapses).
model WorkoutSchedule {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("WorkoutSchedules", fields: [userId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  dayOfWeek     Int       // 0 = Sunday .. 6 = Saturday
  isActive      Boolean   @default(true)
  isPaused      Boolean   @default(false)
  effectiveFrom DateTime  @db.Date
  endDate       DateTime? @db.Date
  createdAt     DateTime  @default(now())

  @@unique([exerciseId, dayOfWeek])
  @@index([userId, dayOfWeek, isActive])
}

// One workout on a date. Saying "yes, I worked out" creates it; logging its
// detail fills in the sets. Marking it unfinished is fine.
// A named workout on a weekday — the building block of a person's weekly plan.
// A day with any of these is a training day; "leg day" and "chest" can both
// sit on the same day. Details (muscle groups, HIIT specifics) come later.
model PlannedWorkout {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("PlannedWorkouts", fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  name        String
  category    WorkoutCategory?
  muscleGroup MuscleGroup?
  isRest      Boolean          @default(false)
  hiitWorkoutId String?
  hiitWorkout   HiitWorkout?   @relation(fields: [hiitWorkoutId], references: [id], onDelete: SetNull)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())

  exercises PlannedExercise[]

  @@index([userId, dayOfWeek])
}

// A pool movement placed inside a planned workout, with whether the person
// wants to log a metric for it when they complete that day, and which one.
model PlannedExercise {
  id               String         @id @default(cuid())
  plannedWorkoutId String
  plannedWorkout   PlannedWorkout @relation(fields: [plannedWorkoutId], references: [id], onDelete: Cascade)
  poolExerciseId   String
  poolExercise     PoolExercise   @relation(fields: [poolExerciseId], references: [id], onDelete: Cascade)
  tracked          Boolean        @default(true)
  metric           WorkoutMetric?
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())

  @@unique([plannedWorkoutId, poolExerciseId])
  @@index([poolExerciseId])
}

model WorkoutSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("WorkoutSessions", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  // A day can hold more than one workout — a lift and a run, hockey and a
  // ride. Each session is one of them: an optional name and category label it
  // in the day's list. Null name/category is a plain "worked out" session or
  // legacy pre-naming data.
  name        String?
  category    WorkoutCategory?
  workoutType WorkoutType?
  durationMin Int?
  finished    Boolean  @default(true)
  // A deliberate rest/skip day: marks the day handled without counting toward
  // scoring later.
  isRest      Boolean  @default(false)
  notes       String?
  sourceEventId String?  // the calendar event this was auto-logged from
  createdAt   DateTime @default(now())

  sets SessionSet[]

  @@index([userId, date])
  @@index([sourceEventId])
}

// What was actually done, one row per exercise per set. A uniform shape holds
// a barbell set, a run, a row, or a plank — only some columns are used.
model SessionSet {
  id         String  @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // A set points at either a legacy per-person Exercise or a shared PoolExercise
  // (the pool is what makes the same movement comparable across people). Newer
  // pool-driven logs use poolExerciseId; metric-only logs (a run) use neither
  // and take their identity from the session's category.
  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  poolExerciseId String?
  poolExercise   PoolExercise? @relation(fields: [poolExerciseId], references: [id], onDelete: SetNull)
  setNumber  Int     @default(1)
  reps       Int?
  weight     Float?
  distance   Float?
  meters     Float?
  seconds    Int?
  unit       String? // snapshot so changing the definition never rewrites history
  finished   Boolean @default(true)
  createdAt  DateTime @default(now())

  @@unique([sessionId, exerciseId, setNumber])
  @@index([exerciseId])
  @@index([poolExerciseId])
}

enum PauseType {
  VACATION
  OTHER
}

// A household-wide pause (a vacation, say). No chores are generated for the
// days it covers, so those days also drop out of scoring; chores resume the
// day after it ends. Creating one puts a multi-day all-day event on the
// calendar (tracked by eventId) so the break is visible and shades its days.
model Pause {
  id        String    @id @default(cuid())
  name      String
  type      PauseType @default(VACATION)
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  eventId   String? // the generated all-day calendar event, removed with the pause
  createdAt DateTime  @default(now())

  @@index([startDate, endDate])
}
